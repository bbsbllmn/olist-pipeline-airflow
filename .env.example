# --- Local Airflow ---
# Keep the UID used by the Airflow image so its CLI can resolve the username.
AIRFLOW_UID=50000

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=olist-bucket-yourname
BQ_BRONZE_DATASET=olist_bronze
BQ_SILVER_DATASET=olist_silver
BQ_GOLD_DATASET=olist_gold

# --- Kaggle (source dataset) ---
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-key

# --- AI (anomaly narration, NL->SQL, doc summaries) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=

# --- Env selector, used by DAGs to branch Compose vs Composer specifics ---
GCP_ENV=dev
