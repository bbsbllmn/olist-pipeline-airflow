olist_analytics:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: olist_bronze          # base/target schema; models override via +schema
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"
      location: US
      threads: 4
      timeout_seconds: 300
      job_execution_timeout_seconds: 600
      job_retries: 1

    prod:
      type: bigquery
      method: oauth   # Composer's Workload Identity -- no keyfile needed
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: olist_bronze
      location: US
      threads: 8
      job_execution_timeout_seconds: 600
      job_retries: 1
